PORT=5000
NODE_ENV=development

MONGO_URI=

# Comma-separated list of frontend origins allowed by CORS and Socket.io in production.
CLIENT_URL=http://localhost:3000
# Where the client portal lives — Stripe sends a client back here after paying.
CLIENT_PORTAL_URL=http://localhost:3001
# Public URL of this API in production, e.g. https://api.example.com
API_PUBLIC_URL=

JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=
DO_SPACES_BUCKET=
DO_SPACES_REGION=
DO_SPACES_CDN_URL=
DO_FOLDER_NAME=uploads

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Used by `npm run seed:superadmin`.
SUPERADMIN_FULL_NAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
